{
  "name": "keystone",
  "version": "0.1.0",
  "private": true,
  "description": "Keystone: orchestratore desktop di un team di agenti AI (Claude, Codex, sim) su un repository git.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "orchestrator",
    "app"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test",
    "orchestrator": "npm run start -w orchestrator --"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
